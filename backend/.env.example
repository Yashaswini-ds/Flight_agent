PROJECT_NAME="FlightAgent Production Booking Engine"
ENV="development"
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flight_agent_db"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flight_agent_test_db"

# Security & Authentication
JWT_SECRET="super-secret-production-quality-jwt-signing-key-key-change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Tax Rate (%)
DEMO_TAX_PERCENTAGE=18.0

# Optional AI LLM Provider Configuration
LLM_API_KEY=""
LLM_MODEL="gpt-3.5-turbo"
